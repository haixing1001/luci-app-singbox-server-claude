#!/bin/sh
# singbox-server-ctl — Sing-Box server config generator and control utility
# Part of luci-app-singbox-server (OpenWrt 25.12)

. /lib/functions.sh

NAME="singbox_server"
CONFIG_DIR="/tmp/etc/${NAME}"
CONFIG_FILE="${CONFIG_DIR}/config.json"
LOG_FILE="/var/log/${NAME}.log"

# --------------------------------------------------------------------------
# JSON helpers (no jq dependency)
# --------------------------------------------------------------------------

json_str() { printf '"%s"' "$(echo "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# --------------------------------------------------------------------------
# Build transport section for an inbound
# --------------------------------------------------------------------------
build_transport() {
	local section="$1"
	local transport

	config_get transport "$section" transport "tcp"

	case "$transport" in
		ws)
			local ws_host ws_path ws_headers
			config_get ws_host  "$section" ws_host  ""
			config_get ws_path  "$section" ws_path  "/"

			printf ',"transport":{"type":"ws","path":%s' "$(json_str "$ws_path")"
			[ -n "$ws_host" ] && \
				printf ',"headers":{"Host":%s}' "$(json_str "$ws_host")"
			printf '}'
			;;
		grpc)
			local svc
			config_get svc "$section" grpc_service_name "GunService"
			printf ',"transport":{"type":"grpc","service_name":%s}' "$(json_str "$svc")"
			;;
		http)
			printf ',"transport":{"type":"http"}'
			;;
		*)
			# Plain TCP — no transport block
			;;
	esac
}

# --------------------------------------------------------------------------
# Build TLS section for an inbound
# --------------------------------------------------------------------------
build_tls() {
	local section="$1"
	local tls_en cert key sni

	config_get_bool tls_en "$section" tls 0

	if [ "$tls_en" -eq 1 ]; then
		config_get cert "$section" tls_cert ""
		config_get key  "$section" tls_key  ""
		config_get sni  "$section" tls_sni  ""

		printf ',"tls":{"enabled":true'
		[ -n "$cert" ] && printf ',"certificate_path":%s' "$(json_str "$cert")"
		[ -n "$key"  ] && printf ',"key_path":%s'          "$(json_str "$key")"
		[ -n "$sni"  ] && printf ',"server_name":%s'       "$(json_str "$sni")"
		printf '}'
	else
		printf ',"tls":{"enabled":false}'
	fi
}

# --------------------------------------------------------------------------
# Build a single sing-box inbound JSON object
# --------------------------------------------------------------------------
build_inbound() {
	local section="$1"
	local enabled custom_cfg

	config_get_bool enabled    "$section" enabled       0
	config_get_bool custom_cfg "$section" custom_config 0

	[ "$enabled" -ne 1 ] && return

	# --- Custom raw JSON mode ---
	if [ "$custom_cfg" -eq 1 ]; then
		local content
		config_get content "$section" custom_config_content ""
		[ -n "$content" ] && printf '%s' "$content"
		return
	fi

	# --- Standard mode ---
	local protocol port uuid local_only accept_proxy tcp_fo log_en remarks

	config_get protocol    "$section" protocol             "vmess"
	config_get port        "$section" port                 "10086"
	config_get uuid        "$section" uuid                 ""
	config_get remarks     "$section" remarks              "$section"
	config_get_bool local_only    "$section" local_only           0
	config_get_bool accept_proxy  "$section" accept_proxy_protocol 0
	config_get_bool tcp_fo        "$section" tcp_fast_open         0
	config_get_bool log_en        "$section" log                   0

	local listen="::"
	[ "$local_only" -eq 1 ] && listen="127.0.0.1"

	printf '{'
	printf '"type":%s'        "$(json_str "$protocol")"
	printf ',"tag":%s'        "$(json_str "in-${protocol}-${section}")"
	printf ',"listen":%s'     "$(json_str "$listen")"
	printf ',"listen_port":%s' "$port"

	# ---- Protocol-specific users/auth ----
	case "$protocol" in
		vmess)
			printf ',"users":[{"uuid":%s,"alterId":0}]' "$(json_str "$uuid")"
			;;
		vless)
			printf ',"users":[{"uuid":%s,"flow":""}]' "$(json_str "$uuid")"
			;;
		trojan)
			printf ',"users":[{"password":%s}]' "$(json_str "$uuid")"
			;;
		shadowsocks)
			local ss_method
			config_get ss_method "$section" ss_method "aes-256-gcm"
			printf ',"method":%s,"password":%s' \
				"$(json_str "$ss_method")" "$(json_str "$uuid")"
			;;
		hysteria2)
			printf ',"users":[{"password":%s}]' "$(json_str "$uuid")"
			printf ',"ignore_client_bandwidth":false'
			# Hysteria2 must have TLS — build it directly
			local cert key sni
			config_get cert "$section" tls_cert ""
			config_get key  "$section" tls_key  ""
			config_get sni  "$section" tls_sni  ""
			printf ',"tls":{"enabled":true'
			[ -n "$cert" ] && printf ',"certificate_path":%s' "$(json_str "$cert")"
			[ -n "$key"  ] && printf ',"key_path":%s'          "$(json_str "$key")"
			[ -n "$sni"  ] && printf ',"server_name":%s'       "$(json_str "$sni")"
			printf '}'
			;;
		tuic)
			printf ',"users":[{"uuid":%s,"password":%s}]' \
				"$(json_str "$uuid")" "$(json_str "$uuid")"
			printf ',"congestion_control":"bbr"'
			printf ',"auth_timeout":"3s"'
			build_tls "$section"
			;;
	esac

	# TCP fast-open
	[ "$tcp_fo"      -eq 1 ] && printf ',"tcp_fast_open":true'

	# Accept PROXY protocol
	[ "$accept_proxy" -eq 1 ] && printf ',"proxy_protocol":true'

	# Transport (VMess/VLESS/Trojan/Shadowsocks only)
	case "$protocol" in
		hysteria2|tuic) ;;
		*) build_transport "$section" ;;
	esac

	# TLS (except Hysteria2/TUIC which are handled above)
	case "$protocol" in
		hysteria2|tuic) ;;
		*) build_tls "$section" ;;
	esac

	printf '}'
}

# --------------------------------------------------------------------------
# Generate sing-box JSON config from UCI
# --------------------------------------------------------------------------
gen_config() {
	local log_level log_output
	config_load "$NAME"
	config_get log_level  global log_level  "warn"
	config_get log_output global log_output "/var/log/${NAME}.log"

	mkdir -p "$CONFIG_DIR"

	# Collect inbounds
	local inbounds="" first=1

	_add_inbound() {
		local ib
		ib="$(build_inbound "$1")"
		[ -z "$ib" ] && return
		if [ "$first" -eq 1 ]; then
			inbounds="$ib"; first=0
		else
			inbounds="${inbounds},${ib}"
		fi
	}
	config_foreach _add_inbound server

	cat > "$CONFIG_FILE" <<-EOCONF
	{
	  "log": {
	    "level": $(json_str "$log_level"),
	    "output": $(json_str "$log_output"),
	    "timestamp": true
	  },
	  "inbounds": [${inbounds}],
	  "outbounds": [
	    { "type": "direct", "tag": "direct" },
	    { "type": "block",  "tag": "block"  }
	  ],
	  "route": {
	    "final": "direct"
	  }
	}
	EOCONF

	logger -t "$NAME" "Config written to $CONFIG_FILE"
	return 0
}

# --------------------------------------------------------------------------
# Service status
# --------------------------------------------------------------------------
get_status() {
	pgrep -f "sing-box run.*${NAME}" > /dev/null 2>&1 \
		&& echo "running" || echo "stopped"
}

# --------------------------------------------------------------------------
# Show last N lines of log, optionally filtered by section tag
# --------------------------------------------------------------------------
show_log() {
	local section="${1:-}"
	local lines="${2:-200}"

	if [ -n "$section" ]; then
		grep -F "in-.*-${section}" "$LOG_FILE" 2>/dev/null | tail -n "$lines"
	else
		tail -n "$lines" "$LOG_FILE" 2>/dev/null
	fi
}

# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------
case "$1" in
	gen_config) gen_config ;;
	status)     get_status ;;
	log)        show_log "$2" "$3" ;;
	*)
		echo "Usage: $0 {gen_config|status|log [section] [lines]}"
		exit 1
		;;
esac
