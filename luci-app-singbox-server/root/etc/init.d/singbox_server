#!/bin/sh /etc/rc.common
# Sing-Box Server init script for OpenWrt 25.12
# Managed by luci-app-singbox-server

START=99
STOP=10
USE_PROCD=1

NAME="singbox_server"
PROG="/usr/bin/sing-box"
CONFIG_DIR="/tmp/etc/${NAME}"
CONFIG_FILE="${CONFIG_DIR}/config.json"
LOG_FILE="/var/log/${NAME}.log"
PID_DIR="/var/run/${NAME}"

start_service() {
	local enabled

	config_load "${NAME}"
	config_get_bool enabled global enabled 0

	[ "${enabled}" -ne 1 ] && {
		logger -t "${NAME}" "Service is disabled, skipping start."
		return 0
	}

	[ ! -x "${PROG}" ] && {
		logger -t "${NAME}" "sing-box binary not found at ${PROG}"
		return 1
	}

	mkdir -p "${CONFIG_DIR}" "${PID_DIR}"

	# Generate configuration from UCI
	singbox-server-ctl gen_config 2>&1 | logger -t "${NAME}" || {
		logger -t "${NAME}" "Configuration generation failed"
		return 1
	}

	# Validate generated config
	"${PROG}" check -c "${CONFIG_FILE}" 2>&1 | logger -t "${NAME}" || {
		logger -t "${NAME}" "Configuration validation failed"
		return 1
	}

	logger -t "${NAME}" "Starting Sing-Box server (config: ${CONFIG_FILE})"

	procd_open_instance "${NAME}"
	procd_set_param command "${PROG}" run -c "${CONFIG_FILE}"
	procd_set_param pidfile "${PID_DIR}/${NAME}.pid"
	procd_set_param respawn 3 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "${CONFIG_FILE}"
	procd_close_instance
}

stop_service() {
	logger -t "${NAME}" "Stopping Sing-Box server"
}

service_triggers() {
	procd_add_reload_trigger "${NAME}"
}

reload_service() {
	logger -t "${NAME}" "Reloading Sing-Box server"
	stop
	sleep 1
	start
}

boot() {
	start "$@"
}
