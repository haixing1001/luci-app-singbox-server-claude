config global 'global'
	option enabled '0'
	option loglevel 'info'
	option bin_path '/usr/bin/sing-box'

config user
	option enabled '0'
	option remarks 'vless-reality'
	option type 'sing-box'
	option protocol 'vless'
	option listen '::'
	option listen_port '443'
	option uuid '11111111-1111-1111-1111-111111111111'
	option flow 'xtls-rprx-vision'
	option transport 'tcp'
	option tls '1'
	option server_name 'www.cloudflare.com'
	option reality '1'
	option reality_dest 'www.cloudflare.com'
	option reality_dest_port '443'
	option reality_private_key ''
	option reality_short_id ''
	option sniff '1'
	option log '1'
