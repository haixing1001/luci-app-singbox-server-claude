#!/bin/sh
# sing-box server firewall rules for OpenWrt fw4 (nftables)

. /lib/functions.sh

add_nft_rule() {
	local section="$1"
	config_get enable "$section" enable 0
	[ "$enable" = "0" ] && return

	config_get port "$section" port
	config_get remarks "$section" remarks
	config_get bind_local "$section" bind_local 0
	config_get protocol "$section" protocol

	# Bound to localhost only – no external firewall rule needed
	[ "$bind_local" = "1" ] && return

	local comment="sing-box-server: $remarks"

	case "$protocol" in
	hysteria2|tuic)
		# QUIC-based: UDP only
		nft add rule inet fw4 input \
			udp dport "$port" \
			accept \
			comment "\"$comment\"" 2>/dev/null
		;;
	shadowsocks)
		# Shadowsocks supports both TCP and UDP
		nft add rule inet fw4 input \
			tcp dport "$port" \
			accept \
			comment "\"$comment\"" 2>/dev/null
		nft add rule inet fw4 input \
			udp dport "$port" \
			accept \
			comment "\"$comment\"" 2>/dev/null
		;;
	*)
		# TCP-based protocols (vmess, vless, trojan, socks, http, etc.)
		nft add rule inet fw4 input \
			tcp dport "$port" \
			accept \
			comment "\"$comment\"" 2>/dev/null
		;;
	esac
}

enable=$(uci -q get sing_box_server.@global[0].enable)
[ "$enable" = "1" ] || exit 0

config_load sing_box_server
config_foreach add_nft_rule "user"
