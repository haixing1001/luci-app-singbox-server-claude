msgid "Global Settings"
msgstr "全局设置"

msgid "Server Config"
msgstr "服务器配置"

msgid "Users Manager"
msgstr "用户管理"

msgid "Enable"
msgstr "启用"

msgid "Remarks"
msgstr "备注"

msgid "Bind Local"
msgstr "本机监听"

msgid "When selected, only local connections are accepted. Recommended when used behind a reverse proxy."
msgstr "勾选后仅接受本机访问，使用反向代理时建议开启。"

msgid "Port"
msgstr "端口"

msgid "Protocol"
msgstr "协议"

msgid "Transport"
msgstr "传输方式"

msgid "Status"
msgstr "状态"

msgid "Credential"
msgstr "凭证"

msgid "Version"
msgstr "版本"

msgid "Restart Service"
msgstr "重启服务"

msgid "Restarting..."
msgstr "重启中..."

msgid "Restart failed."
msgstr "重启失败。"

msgid "UUID"
msgstr "UUID"

msgid "Add one or more UUIDs for multi-user support."
msgstr "可添加多个 UUID 支持多用户。"

msgid "Alter ID"
msgstr "额外 ID (AlterID)"

msgid "Keep at 0 for AEAD encryption (recommended)."
msgstr "保持 0 以使用 AEAD 加密（推荐）。"

msgid "Flow"
msgstr "流控"

msgid "None"
msgstr "无"

msgid "Encrypt Method"
msgstr "加密方式"

msgid "Password"
msgstr "密码"

msgid "One password per user."
msgstr "每个用户一个密码。"

msgid "Network"
msgstr "网络"

msgid "Obfs Password"
msgstr "混淆密码"

msgid "Optional Salamander obfuscation password."
msgstr "可选的 Salamander 混淆密码。"

msgid "Upload Bandwidth (Mbps)"
msgstr "上行带宽（Mbps）"

msgid "Server-side upload limit. Leave empty for unlimited."
msgstr "服务端上行限速，留空不限速。"

msgid "Download Bandwidth (Mbps)"
msgstr "下行带宽（Mbps）"

msgid "Server-side download limit. Leave empty for unlimited."
msgstr "服务端下行限速，留空不限速。"

msgid "UUID"
msgstr "UUID"

msgid "Each UUID must be paired with a password at the same position."
msgstr "每个 UUID 需与下方密码列表中对应位置的密码配对。"

msgid "Password (per UUID)"
msgstr "密码（对应 UUID）"

msgid "Must correspond to the UUID list above. TUIC always requires TLS."
msgstr "须与上方 UUID 列表一一对应。TUIC 必须启用 TLS。"

msgid "Congestion Control"
msgstr "拥塞控制算法"

msgid "Username"
msgstr "用户名"

msgid "Leave empty for no authentication."
msgstr "留空表示不启用认证。"

msgid "WebSocket Path"
msgstr "WebSocket 路径"

msgid "WebSocket Host"
msgstr "WebSocket 主机名"

msgid "Overrides the Host header. Leave empty to use the client value."
msgstr "覆盖 Host 头，留空则使用客户端值。"

msgid "HTTP/2 Path"
msgstr "HTTP/2 路径"

msgid "HTTP/2 Host"
msgstr "HTTP/2 主机名"

msgid "gRPC Service Name"
msgstr "gRPC 服务名称"

msgid "HTTP Upgrade Path"
msgstr "HTTP Upgrade 路径"

msgid "HTTP Upgrade Host"
msgstr "HTTP Upgrade 主机名"

msgid "Enable TLS"
msgstr "启用 TLS"

msgid "Certificate File"
msgstr "证书文件路径"

msgid "Key File"
msgstr "私钥文件路径"

msgid "as:"
msgstr "例："

msgid "Enable REALITY"
msgstr "启用 REALITY"

msgid "REALITY replaces TLS. When enabled the certificate/key above are ignored."
msgstr "REALITY 替代 TLS，启用后上方证书/密钥字段将被忽略。"

msgid "Handshake Server"
msgstr "握手目标服务器"

msgid "A real TLS 1.3 server that your server will masquerade as."
msgstr "服务器将模拟的真实 TLS 1.3 站点。"

msgid "Handshake Port"
msgstr "握手目标端口"

msgid "Private Key (X25519)"
msgstr "私钥（X25519）"

msgid "Generate with: sing-box generate reality-keypair"
msgstr "可用命令生成：sing-box generate reality-keypair"

msgid "Public Key (X25519)"
msgstr "公钥（X25519）"

msgid "Share this with clients."
msgstr "将此公钥分发给客户端。"

msgid "Short ID"
msgstr "短 ID"

msgid "Hex string up to 8 bytes (0-16 hex chars). e.g. 1234abcd"
msgstr "最多 8 字节的十六进制字符串（0–16 个十六进制字符），如 1234abcd。"

msgid "Accept LAN Access"
msgstr "允许局域网访问"

msgid "When selected, clients on the LAN can route through this server. Use with caution."
msgstr "勾选后局域网客户端可经由此服务器访问外网，请谨慎使用。"

msgid "Logs"
msgstr "日志"

msgid "Clear Logs"
msgstr "清空日志"

msgid "Collecting data..."
msgstr "获取中..."
